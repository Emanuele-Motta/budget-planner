{
  "name": "budget-planner-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "lint": "npm run lint -w server && npm run lint -w client",
    "format": "prettier --write .",
    "setup:local": "bash ./scripts/setup-local.sh",
    "dev:local": "npm run setup:local && npm run dev",
    "deploy:up": "docker compose -f deploy-compose.prod.yml --env-file .env.prod up -d --build",
    "deploy:down": "docker compose -f deploy-compose.prod.yml --env-file .env.prod down",
    "deploy:logs": "docker compose -f deploy-compose.prod.yml --env-file .env.prod logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
