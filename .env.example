# Server
# Con Supabase usa la connection string del pooler (porta 6543) con sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT_URL opzionale ma consigliata per Prisma migrate (porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
JWT_SECRET="super-secret-access-token"
JWT_REFRESH_SECRET="super-secret-refresh-token"
OPENAI_API_KEY=""
PORT=4000
CLIENT_URL="http://localhost:5173"

# Client
# In produzione su Netlify imposta l'URL pubblico del backend
VITE_API_URL="http://localhost:4000/api"
